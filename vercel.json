{
  "version": 2,
  "name": "nime-anime-streaming",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/docs/swagger.json",
      "dest": "/public/swagger.json"
    },
    {
      "src": "/docs/swagger-ui",
      "dest": "/public/swagger-ui.html"
    },
    {
      "src": "/dashboard",
      "dest": "/public/dashboard.html"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "API_BASE_URL": "https://nime-ku-nu.vercel.app"
  }
}