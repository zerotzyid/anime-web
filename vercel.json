{
  "version": 2,
  "name": "nime-anime-streaming",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/docs/swagger.json",
      "dest": "/api/swagger.json"
    },
    {
      "src": "/docs/swagger-ui",
      "dest": "/docs/swagger-ui.html"
    },
    {
      "src": "/docs/swagger-ui/(.*)",
      "dest": "/docs/swagger-ui/$1"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard/dashboard.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "PORT": "3474",
    "API_BASE_URL": "https://nime-anime-streaming.vercel.app"
  }
}