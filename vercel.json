{
  "version": 2,
  "name": "nime-anime-streaming",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "API_BASE_URL": "https://nime-ku-nu.vercel.app"
  }
}